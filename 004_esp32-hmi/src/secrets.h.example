#pragma once

// Copy this file to secrets.h and fill in your real values.
// secrets.h is gitignored so credentials never get committed.

#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// Home location, used for outside weather (Open-Meteo) and severe weather
// alerts (NWS). Look up coordinates at https://www.latlong.net/
#define LOCATION_LAT 40.7128
#define LOCATION_LON -74.0060

// NWS (weather.gov) requires every client to send a descriptive User-Agent
// with a way to contact you: https://www.weather.gov/documentation/services-web-api
#define NWS_USER_AGENT "esp32-hmi (your-email@example.com)"

// NYT Developer API key (free, separate from a nytimes.com reader login) -
// register at https://developer.nytimes.com/
#define NYT_API_KEY "your-nyt-api-key"
